<?xml version="1.0" encoding="utf-8"?>
<!-- 資料擷取規則（Android 12+，STEP 3，R-3）：與 backup_rules.xml
     同一排除範圍——只排除三類診斷檔案目錄（診斷 CSV、眼區驗證影格、
     閃退報告），SharedPreferences（校正模型、條件歷史、使用者設定）
     一律不排除。雲端備份與裝置間傳輸皆排除同一範圍。
     合併後清單與實機備份還原行為待 CI／實機驗證。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="gaze-logs" />
        <exclude domain="file" path="verify-frames" />
        <exclude domain="file" path="crash-reports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="gaze-logs" />
        <exclude domain="file" path="verify-frames" />
        <exclude domain="file" path="crash-reports" />
    </device-transfer>
</data-extraction-rules>
