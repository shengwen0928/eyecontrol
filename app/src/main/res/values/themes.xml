<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EyeControl" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ec_sage_deep</item>
        <item name="colorOnPrimary">@color/ec_card_white</item>
        <item name="colorPrimaryContainer">@color/ec_sage_soft</item>
        <item name="colorOnPrimaryContainer">@color/ec_text</item>
        <item name="colorSecondary">@color/ec_sage</item>
        <item name="colorOnSecondary">@color/ec_text</item>
        <item name="colorSurface">@color/ec_card_white</item>
        <item name="colorOnSurface">@color/ec_text</item>
        <item name="colorSurfaceVariant">@color/ec_stone</item>
        <item name="colorOnSurfaceVariant">@color/ec_text_secondary</item>
        <item name="colorOutline">@color/ec_stone</item>
        <item name="colorError">@color/ec_error</item>
        <item name="colorOnError">@color/ec_card_white</item>
        <item name="android:windowBackground">@color/ec_bg_ivory</item>
        <item name="android:statusBarColor">@color/ec_bg_ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ec_text</item>
        <item name="android:textColorSecondary">@color/ec_text_secondary</item>
    </style>

    <style name="Theme.EyeControl.Fullscreen" parent="Theme.EyeControl">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
